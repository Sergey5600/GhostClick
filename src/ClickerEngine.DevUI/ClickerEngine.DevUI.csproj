<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClickerEngine.DevUI</RootNamespace>
    <AssemblyName>ClickerEngine.DevUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allows the WPF project to be compiled from a non-Windows CI machine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClickerEngine.Core\ClickerEngine.Core.csproj" />
  </ItemGroup>

</Project>
