<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GhostClick.App</RootNamespace>
    <AssemblyName>GhostClick</AssemblyName>
    <StartupObject>GhostClick.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The shell icon on the .exe: Explorer, taskbar, Alt-Tab, pinned shortcuts. -->
    <ApplicationIcon>..\..\assets\AppIcon.ico</ApplicationIcon>
    <!-- Allows the WPF project to be compiled from a non-Windows CI machine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhostClick.Bridge\GhostClick.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also a WPF resource, for the window's own icon (MainWindow sets Window.Icon). -->
    <Resource Include="..\..\assets\AppIcon.ico" Link="Resources\AppIcon.ico" />
  </ItemGroup>

  <!--
    The interface itself: plain files served to WebView2 from next to the executable. They
    stay loose even in a single-file publish, because MainWindow maps the wwwroot folder
    beside the .exe.
  -->
  <ItemGroup>
    <None Remove="wwwroot\**" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
