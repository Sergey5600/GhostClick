<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClickerEngine.DevUI</RootNamespace>
    <AssemblyName>ClickerEngine.DevUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The shell icon on the .exe: taskbar, Explorer, Alt-Tab, pinned shortcuts. -->
    <ApplicationIcon>..\..\assets\AppIcon.ico</ApplicationIcon>
    <!-- Allows the WPF project to be compiled from a non-Windows CI machine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClickerEngine.Core\ClickerEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Also embedded as a resource so Window.Icon can bind to it. ApplicationIcon alone
      covers the .exe, but a window loaded through `dotnet run` on the .dll would fall back
      to the generic icon without this.
    -->
    <Resource Include="..\..\assets\AppIcon.ico" Link="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
